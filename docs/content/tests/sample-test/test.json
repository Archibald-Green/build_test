          "options": [
            { "id": "a", "text": "30" },
            { "id": "b", "text": "36" },
            { "id": "c", "text": "42" },
            { "id": "d", "text": "48" }
          ],
          "correctOptionIds": ["d"],
          "explanation": "Каждое число в два раза больше предыдущего, поэтому 24 × 2 = 48."
        }
      ]
    },
