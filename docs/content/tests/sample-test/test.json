        {
          "id": "math-001",
          "type": "single-choice",
          "prompt": "Если 2y + 3 ≤ 11, чему равно наибольшее возможное значение y?",
          "points": 1,
          "options": [
            { "id": "a", "text": "2" },
            { "id": "b", "text": "4" },
            { "id": "c", "text": "7" },
            { "id": "d", "text": "8" }
          ],
          "correctOptionIds": ["b"],
          "explanation": "Вычтем 3 из обеих частей неравенства и разделим на 2: y ≤ 4."
        },
        {
          "id": "math-002",
          "type": "single-choice",
          "prompt": "На каком графике изображена линейная функция?",
