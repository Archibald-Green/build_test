{
  "schemaVersion": 1,
  "id": "sample-test",
  "version": 1,
  "title": "Sample Admission Test",
  "description": "Mathematics, analytical thinking, and English practice.",
  "language": "en",
  "instructions": "Choose one answer for each question. Images and audio may appear in some questions.",
  "headerLinks": [
    {
      "label": "Preparation guide",
      "url": "https://example.com/preparation"
    },
    {
      "label": "Contact",
      "url": "mailto:tests@example.com"
    }
  ],
  "sections": [
    {
      "id": "mathematics",
      "title": "Mathematics",
      "description": "Core numerical reasoning.",
      "questions": [
        {
          "id": "math-001",
          "type": "single-choice",
          "prompt": "If 2y + 3 is at most 11, what is the greatest possible value of y?",
          "points": 1,
          "options": [
            { "id": "a", "text": "2" },
            { "id": "b", "text": "4" },
            { "id": "c", "text": "7" },
            { "id": "d", "text": "8" }
          ],
          "correctOptionIds": ["b"],
          "explanation": "Subtract 3 from both sides and divide by 2: y is at most 4."
        },
        {
          "id": "math-002",
          "type": "single-choice",
          "prompt": "Which graph represents a linear function?",
          "points": 1,
          "media": {
            "image": {
              "src": "media/linear-functions.svg",
              "alt": "Four small coordinate graphs labeled A through D"
            }
          },
          "options": [
            { "id": "a", "text": "Graph A" },
            { "id": "b", "text": "Graph B" },
            { "id": "c", "text": "Graph C" },
            { "id": "d", "text": "Graph D" }
          ],
          "correctOptionIds": ["c"],
          "explanation": "Graph C is a straight, non-vertical line and represents a linear function."
        }
      ]
    },
    {
      "id": "analytical-thinking",
      "title": "Analytical Thinking",
      "description": "Patterns, sequences, and logical conclusions.",
      "questions": [
        {
          "id": "logic-001",
          "type": "single-choice",
          "prompt": "All poets are writers. Some writers are teachers. Which conclusion must be true?",
          "points": 1,
          "options": [
            { "id": "a", "text": "All teachers are poets" },
            { "id": "b", "text": "Some poets are teachers" },
            { "id": "c", "text": "All poets are writers" },
            { "id": "d", "text": "No writers are teachers" }
          ],
          "correctOptionIds": ["c"],
          "explanation": "The first statement directly establishes that all poets are writers."
        },
        {
          "id": "logic-002",
          "type": "single-choice",
          "prompt": "What comes next in the sequence: 3, 6, 12, 24, ...?",
          "points": 1,
          "options": [
            { "id": "a", "text": "30" },
            { "id": "b", "text": "36" },
            { "id": "c", "text": "42" },
            { "id": "d", "text": "48" }
          ],
          "correctOptionIds": ["d"],
          "explanation": "Each number is twice the preceding number, so 24 multiplied by 2 is 48."
        }
      ]
    },
    {
      "id": "english",
      "title": "English",
      "description": "Vocabulary and listening comprehension.",
      "questions": [
        {
          "id": "english-001",
          "type": "single-choice",
          "prompt": "Choose the word closest in meaning to \"brief\".",
          "points": 1,
          "options": [
            { "id": "a", "text": "Short" },
            { "id": "b", "text": "Difficult" },
            { "id": "c", "text": "Ancient" },
            { "id": "d", "text": "Careful" }
          ],
          "correctOptionIds": ["a"],
          "explanation": "\"Brief\" means short in duration or length."
        },
        {
          "id": "english-002",
          "type": "single-choice",
          "prompt": "Listen to the recording. Where will the speaker meet the group?",
          "points": 1,
          "media": {
            "audio": {
              "src": "media/meeting-place.mp3",
              "caption": "Short listening prompt"
            }
          },
          "options": [
            { "id": "a", "text": "At the library" },
            { "id": "b", "text": "At the station" },
            { "id": "c", "text": "At the museum" },
            { "id": "d", "text": "At the cafe" }
          ],
          "correctOptionIds": ["b"],
          "explanation": "The speaker says the group should meet beside the main station entrance."
        }
      ]
    }
  ]
}
