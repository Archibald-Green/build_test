          "options": [
            { "id": "a", "text": "Все учителя являются поэтами" },
            { "id": "b", "text": "Некоторые поэты работают учителями" },
            { "id": "c", "text": "Все поэты являются писателями" },
            { "id": "d", "text": "Ни один писатель не работает учителем" }
          ],
          "correctOptionIds": ["c"],
          "explanation": "Первое условие прямо утверждает, что все поэты являются писателями."
        },
        {
          "id": "logic-002",
          "type": "single-choice",
          "prompt": "Какое число должно быть следующим в последовательности: 3, 6, 12, 24, ...?",
