          "media": {
            "image": {
              "src": "media/linear-functions.svg",
              "alt": "Четыре небольших графика на координатной плоскости, обозначенные буквами A, B, C и D"
            }
          },
          "options": [
            { "id": "a", "text": "График A" },
            { "id": "b", "text": "График B" },
            { "id": "c", "text": "График C" },
            { "id": "d", "text": "График D" }
          ],
          "correctOptionIds": ["c"],
          "explanation": "График C является прямой невертикальной линией и задаёт линейную функцию."
        }
      ]
